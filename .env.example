# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
API_HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Datastores ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://atrrehub:atrrehub@localhost:5432/atrrehub?schema=public
REDIS_URL=redis://localhost:6379

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-0000000000000000000000000000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ENCRYPTION_KEY=change-me-in-production-1111111111111111111111111111111111111111
WIDGET_TOKEN_SECRET=change-me-in-production-2222222222222222222222222222222222
DB_RLS=false

# ── Object storage (S3 compatible) ────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atrrehub
S3_ACCESS_KEY_ID=atrrehub
S3_SECRET_ACCESS_KEY=atrrehub123
S3_FORCE_PATH_STYLE=true

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_DRIVER=log
MAIL_FROM="Atrrehub <support@atrrehub.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Inbound (IMAP polling)
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ── AI providers ──────────────────────────────────────────────────────────────
# The platform runs fully without any provider key using the deterministic
# `local` provider. Set keys to enable real models.
AI_DEFAULT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
GEMINI_API_KEY=
LOCAL_LLM_BASE_URL=
AI_EMBEDDING_DIMENSIONS=1536

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=atrrehub-api
METRICS_ENABLED=true

# ── Workers ───────────────────────────────────────────────────────────────────
WORKERS_ENABLED=true
WORKER_CONCURRENCY=5

# ── Web app ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
