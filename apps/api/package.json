{
  "name": "@atrrehub/api",
  "version": "0.1.0",
  "private": true,
  "description": "Atrrehub platform API, realtime gateway and workers",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --enable-source-maps -r @swc-node/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node -r @swc-node/register prisma/seed.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec \"node -r @swc-node/register src/main.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/websockets": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2",
    "luxon": "^3.5.0",
    "mammoth": "^1.9.0",
    "node-html-parser": "^7.0.1",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8",
    "@swc-node/register": "^1.10.9",
    "nodemon": "^3.1.9"
  }
}
